<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissões essenciais para streaming, playback em background e auto-atualização -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".NerfMusicApp"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NERFMusic">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NERFMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- DeepLinks para Convites de Sessão JAM (No-Account) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="nerfmusic"
                    android:host="jam" />
            </intent-filter>

            <!-- DeepLinks para Músicas (Social Share Cards) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="nerfmusic"
                    android:host="track" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="nerfmusic.app"
                    android:pathPrefix="/track" />
                <data
                    android:scheme="http"
                    android:host="nerfmusic.app"
                    android:pathPrefix="/track" />
                <data
                    android:scheme="https"
                    android:host="music.youtube.com"
                    android:path="/watch" />
                <data
                    android:scheme="http"
                    android:host="music.youtube.com"
                    android:path="/watch" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="nerfmusic.app"
                    android:pathPrefix="/jam" />
                <data
                    android:scheme="http"
                    android:host="nerfmusic.app"
                    android:pathPrefix="/jam" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.SharePreviewActivity" android:exported="false"
            android:theme="@style/Theme.NERFMusic" />

        <!-- Widgets de Tela Inicial (Compacto e Expandido) -->
        <receiver
            android:name=".widget.CompactPlayerWidgetProvider"
            android:exported="true"
            android:label="NERF Player Compacto">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.nerf.music.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.nerf.music.widget.ACTION_SKIP_NEXT" />
                <action android:name="com.nerf.music.widget.ACTION_SKIP_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.ExpandedPlayerWidgetProvider"
            android:exported="true"
            android:label="NERF Player 4×1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.nerf.music.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.nerf.music.widget.ACTION_SKIP_NEXT" />
                <action android:name="com.nerf.music.widget.ACTION_SKIP_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_expanded_info" />
        </receiver>

        <receiver
            android:name=".widget.ThreeByOneWidgetProvider"
            android:exported="true"
            android:label="NERF Player 3×1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.nerf.music.widget.ACTION_PLAY_PAUSE" />
                <action android:name="com.nerf.music.widget.ACTION_SKIP_NEXT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_three_info" />
        </receiver>

        <!-- Serviço de Reprodução Media3 com suporte a segundo plano -->
        <service
            android:name=".player.AudioPlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- FileProvider seguro para instalação de APKs baixados pelo In-App Updater -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
