<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_three_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">
    <ImageView android:id="@+id/iv_three_cover" android:layout_width="64dp" android:layout_height="64dp"
        android:contentDescription="Capa do álbum" android:scaleType="centerCrop" android:src="@drawable/ic_widget_placeholder" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp"
        android:layout_marginEnd="10dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_three_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:text="NERF Music" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_three_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="Toque para ouvir" android:textColor="#B3FFFFFF" android:textSize="11sp" />
        <ProgressBar android:id="@+id/pb_three_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="8dp"
            android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress_bar" />
    </LinearLayout>
    <ImageButton android:id="@+id/btn_three_skip" android:layout_width="34dp" android:layout_height="34dp"
        android:background="@drawable/widget_button_circle_bg" android:contentDescription="@string/action_next"
        android:padding="8dp" android:scaleType="centerInside" android:src="@drawable/ic_widget_next" />
    <ImageButton android:id="@+id/btn_three_play_pause" android:layout_width="42dp" android:layout_height="42dp"
        android:layout_marginStart="8dp" android:background="@drawable/widget_button_primary_bg"
        android:contentDescription="@string/action_play" android:padding="11dp" android:scaleType="centerInside"
        android:tint="#FF17191F" android:src="@drawable/ic_widget_play" />
</LinearLayout>
