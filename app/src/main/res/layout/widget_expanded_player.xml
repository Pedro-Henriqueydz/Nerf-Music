<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Topo: Player Atual -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_widget_cover"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Capa do Álbum"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="NERF Music"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Toque para ouvir"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_widget_expanded_skip_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_button_circle_bg"
            android:contentDescription="@string/action_previous"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_prev" />

        <ImageButton
            android:id="@+id/btn_widget_expanded_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button_circle_bg"
            android:contentDescription="@string/action_play"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/btn_widget_expanded_skip_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_button_circle_bg"
            android:contentDescription="@string/action_next"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>

    <!-- Barra de Progresso Fina -->
    <ProgressBar
        android:id="@+id/pb_widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_bar" />


    <!-- 5 capas quadradas lado a lado -->
    <LinearLayout
        android:id="@+id/layout_rec_covers_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_rec_cover_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:layout_marginEnd="6dp"
            android:contentDescription="Musica recomendada 1"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_placeholder" />

        <ImageView
            android:id="@+id/iv_rec_cover_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:layout_marginEnd="6dp"
            android:contentDescription="Musica recomendada 2"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_placeholder" />

        <ImageView
            android:id="@+id/iv_rec_cover_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:layout_marginEnd="6dp"
            android:contentDescription="Musica recomendada 3"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_placeholder" />

        <ImageView
            android:id="@+id/iv_rec_cover_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:layout_marginEnd="6dp"
            android:contentDescription="Musica recomendada 4"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_placeholder" />

        <ImageView
            android:id="@+id/iv_rec_cover_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="Musica recomendada 5"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_placeholder" />

    </LinearLayout>

</LinearLayout>
