<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Capa do Álbum Bem Arredondada -->
    <ImageView
        android:id="@+id/iv_compact_cover"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:contentDescription="Capa do Álbum"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_placeholder" />

    <!-- Título e Artista -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_compact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NERF Music"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_compact_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Toque para ouvir"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Controles Redesenhados -->
    <ImageButton
        android:id="@+id/btn_widget_skip_prev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_button_circle_bg"
        android:contentDescription="@string/action_previous"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_prev" />

    <ImageButton
        android:id="@+id/btn_widget_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_button_circle_bg"
        android:contentDescription="@string/action_play"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_play" />

    <ImageButton
        android:id="@+id/btn_widget_skip_next"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_button_circle_bg"
        android:contentDescription="@string/action_next"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_next" />

</LinearLayout>
