<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Desabilita tráfego HTTP em texto claro em todo o aplicativo -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Aceita apenas certificados válidos da autoridade certificadora (CA) do sistema Android -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
